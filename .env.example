# Sao chép file này thành ".env" (không commit .env thật lên git) và điền giá trị thật.
# Xem includes/env.php để biết cách các biến này được nạp.

# --- Kết nối cơ sở dữ liệu ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=tech_store

# --- Khoá mã hoá ứng dụng ---
# Dùng để mã hoá các setting nhạy cảm lưu trong bảng `settings`
# (Gemini API key, mật khẩu SMTP, secret key VNPAY/MoMo, Google client secret...).
# Sinh 1 khoá mới bằng lệnh:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# TUYỆT ĐỐI không dùng chung APP_KEY giữa môi trường dev và production,
# và không commit giá trị thật lên git.
APP_KEY=base64:THAY_BANG_KHOA_NGAU_NHIEN_CUA_BAN
